{
  "name": "@impermeable/codemirror-lang-verbose",
  "version": "1.0.0",
  "description": "CodeMirror language support for Lean4 Verbose language",
  "homepage": "https://github.com/impermeable/codemirror-lang-verbose#readme",
  "bugs": {
    "url": "https://github.com/impermeable/codemirror-lang-verbose/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impermeable/codemirror-lang-verbose.git"
  },
  "license": "MIT",
  "author": "TU-e-SEP-2025-Group-14",
  "main": "dist/index.js",
  "exports": {
    "import": "./dist/index.js"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "npx jest",
    "lezer-generator": "npx lezer-generator --output src/syntax.ts --typeScript src/syntax.grammar",
    "esbuild": "node esbuild.mjs --release",
    "gen-types": "npx tsc",
    "build": "npm run lezer-generator && npm run gen-types && npm run esbuild",
    "lint": "npx eslint .",
    "lint-fix": "npx eslint . --fix"
  },
  "dependencies": {
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.13.1"
  }, 
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lezer/generator": "^1.8.1",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jest": "^30.5.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
